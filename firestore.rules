rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Espace personnel : chaque utilisateur connecté n'accède qu'à ses propres données.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Espace partagé : seules les adresses Google listées ci-dessous (e-mail vérifié) lisent et modifient tout.
    // Écrivez les adresses en minuscules. Pour ajouter quelqu'un : ajoutez son adresse puis « Publier ».
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['vous@gmail.com', 'autre.personne@gmail.com'];
    }
    match /workspaces/{workspace}/{document=**} {
      allow read, write: if isMember();
    }
  }
}
